{
 "rule": "@stylistic/no-extra-semicolons",
 "source": "@stylistic/stylelint-plugin 6.0.1: lib/rules/no-extra-semicolons/index.test.ts",
 "groups": [
  {
   "config": [
    true
   ],
   "compute_edit_info": false,
   "accept": [
    {
     "code": "@import 'x.css';",
     "description": "an import closed by its own semicolon"
    },
    {
     "code": ".foo { color: red }",
     "description": "a declaration with no semicolon behind it"
    },
    {
     "code": ".foo { color: red; }",
     "description": "a declaration closed by a semicolon"
    },
    {
     "code": ".foo { color: red; display: block; }",
     "description": "two declarations, each closed by a semicolon"
    },
    {
     "code": ".foo { color: red; display: block }",
     "description": "two declarations, the last with no semicolon behind it"
    },
    {
     "code": "@media screen { a { color: red; } }",
     "description": "a rule nested inside a media query"
    },
    {
     "code": "/* comment */",
     "description": "a comment"
    },
    {
     "code": "/* comment; */",
     "description": "a semicolon inside a comment"
    },
    {
     "code": "/* ;;comment;; words;; */",
     "description": "semicolons standing among the words of a comment"
    },
    {
     "code": "a { content: ''; }",
     "description": "an empty string for a value"
    },
    {
     "code": "a { content: ';'; }",
     "description": "a semicolon inside a string"
    },
    {
     "code": "a { content: ';;'; }",
     "description": "two semicolons inside a string"
    },
    {
     "code": "a { content: ';\t; ;'; }",
     "description": "semicolons and whitespace inside a string"
    },
    {
     "code": ":root { --foo: red; --bar: blue; }",
     "description": "two custom properties, each closed by a semicolon"
    }
   ],
   "reject": [
    {
     "code": ";",
