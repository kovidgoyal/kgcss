# An element of an ElementTree-style tree
type _Element = Any

class Snapshot:
    def __new__(cls, root: _Element, quirks_mode: bool = False) -> Self: ...
    @property
    def count(self) -> int: ...
    @property
    def quirks_mode(self) -> bool: ...
    def match(
        self,
        selectors: Sequence[CompiledSelector],
        ignore_inappropriate: bool,
        scope: int,
        root: int,
        target: int,
        first_only: bool,
        /,
    ) -> list[_Element] | bool: ...
    def index_of(self, element: _Element, /) -> int: ...
    def element(self, index: int, /) -> _Element: ...

@final
class CompiledSelector:
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def has_nesting(self) -> bool: ...
    @property
    def has_pseudo_element(self) -> bool: ...
    @property
    def relative(self) -> bool: ...
    # (kind, op, flags, start, end, subtree_end, a, b, name, value, ns): the types of the last three
    # depend on the kind, see kgcss.selectors.build_tree()
    def nodes(self) -> tuple[tuple[int, int, int, int, int, int, int, int, Any, Any, Any], ...]: ...
    def specificity(self, nesting: tuple[int, int, int] = ..., /) -> tuple[int, int, int]: ...

