# Type stubs for the C extension module built from csrc/. Keep in sync with
# the method tables, types and constants in csrc/module.c and csrc/types.c.

from collections.abc import Iterator
from typing import Final, Literal, final

from kgcss.enums import TokenType

GIL_DISABLED_BUILD: Final[int]
_TOKEN_TYPE_NAMES: Final[tuple[str | None, ...]]
_ERROR_KINDS: Final[tuple[str, ...]]

def serialize_string(text: str, /) -> str: ...
def serialize_identifier(text: str, /) -> str: ...
def tokenize(source: str, /, *, comments: bool = True) -> TokenStream: ...
def parse_component_value_list(source: str, /, *, comments: bool = True) -> ComponentValueList: ...
def parse_stylesheet(source: str, /, *, comments: bool = True) -> NodeList: ...
def parse_rule_list(source: str | Block, /, *, comments: bool = True) -> NodeList: ...
def parse_block_contents(source: str | Block, /, *, comments: bool = True) -> NodeList: ...
def parse_one_rule(source: str, /, *, comments: bool = True) -> AtRule | QualifiedRule | ParseError: ...
def parse_one_declaration(source: str, /, *, comments: bool = True) -> Declaration | ParseError: ...
def parse_one_component_value(source: str, /, *, comments: bool = True) -> Token | Block | Function | ParseError: ...

@final
class ParseError:
    @property
    def offset(self) -> int: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def kind(self) -> str: ...
    @property
    def message(self) -> str: ...

@final
class Token:
    @property
    def type(self) -> TokenType: ...
    @property
    def value(self) -> str | int | float | None: ...
    @property
    def unit(self) -> str | None: ...
    @property
    def pos(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def stream(self) -> TokenStream: ...
    @property
    def source_text(self) -> str: ...
    @property
    def representation(self) -> str | None: ...
    @property
    def is_integer(self) -> bool: ...
    @property
    def hash_is_id(self) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    def is_delim(self, ch: str, /) -> bool: ...

@final
class TokenStream:
    @property
    def source(self) -> str: ...
    @property
    def errors(self) -> tuple[ParseError, ...]: ...
    def line_col(self, offset: int, /) -> tuple[int, int]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> Token: ...
    def __iter__(self) -> Iterator[Token]: ...

@final
class Block:
    @property
    def type(self) -> Literal[TokenType.LEFT_CURLY, TokenType.LEFT_SQUARE, TokenType.LEFT_PAREN]: ...
    @property
    def opener(self) -> Literal['{', '[', '(']: ...
    @property
    def content(self) -> ComponentValueList: ...
    @property
    def pos(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def source_text(self) -> str: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def stream(self) -> TokenStream: ...

@final
class Function:
    @property
    def type(self) -> Literal[TokenType.FUNCTION]: ...
    @property
    def name(self) -> str: ...
    @property
    def arguments(self) -> ComponentValueList: ...
    @property
    def pos(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def source_text(self) -> str: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def stream(self) -> TokenStream: ...

@final
class ComponentValueList:
    @property
    def text(self) -> str: ...
    @property
    def pos(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def stream(self) -> TokenStream: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> Token | Block | Function: ...
    def __iter__(self) -> Iterator[Token | Block | Function]: ...

class _Node:
    @property
    def pos(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def stream(self) -> TokenStream: ...
    @property
    def source_text(self) -> str: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...

@final
class AtRule(_Node):
    @property
    def name(self) -> str: ...
    @property
    def prelude(self) -> ComponentValueList: ...
    @property
    def block(self) -> Block | None: ...

@final
class QualifiedRule(_Node):
    @property
    def prelude(self) -> ComponentValueList: ...
    @property
    def block(self) -> Block: ...

@final
class Declaration(_Node):
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> ComponentValueList: ...
    @property
    def important(self) -> bool: ...

@final
class NodeList:
    @property
    def stream(self) -> TokenStream: ...
    @property
    def errors(self) -> tuple[ParseError, ...]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> AtRule | QualifiedRule | Declaration | Token: ...
    def __iter__(self) -> Iterator[AtRule | QualifiedRule | Declaration | Token]: ...
